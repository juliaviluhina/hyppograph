# Copy to .env and fill in. .env is gitignored; .env.example is tracked.
# HyppoGraph reads only the data-dir path and these knobs — never personal data via env.

# Root of the inputs/outputs tree. Lives entirely outside this repo.
# (real value in .env; how that folder is stored/versioned/backed up is the user's call)
HYPPO_DATA_DIR=/absolute/path/to/your/hyppograph-data

# HyppoVisor MCP page-read endpoint: NOT an env var anymore. This project's
# instance is a committed .mcp.json entry (hyppovisor-hyppograph -> port 7359).
# Launch it with:  open -na HyppoVisor --args --instance hyppograph --port 7359
# See .claude/skills/hyppovisor/SKILL.md.

# Model + collection tuning (defaults applied when unset)
HYPPO_MODEL_FAST=claude-haiku-4-5-20251001
HYPPO_PACING_MS=3000
HYPPO_FETCH_CAP=300
HYPPO_DEFAULT_DEPTH=25

# --- Eval harness (feature 003) — credentials read from the environment only, never
# from argv, never prompted (FR-016). Values live in a gitignored .env or your shell
# profile; this file carries names only (FR-017).

# Judge model access (non-Claude — the developer's GPT Luna access, per
# specs/003-eval-harness/eval-strategy.md §4 — locked to GPT Luna, never a Claude
# model). Required only for judge-graded per-component eval cases (extraction
# faithfulness, pre-triage reason).
HYPPO_JUDGE_API_KEY=
# Judge HTTP endpoint. GPT Luna is served on the OpenAI *Responses* API shape, not
# Chat Completions — https://opencode.ai/zen/go/v1/responses — different
# request/response shape than the chat/completions models in the same pool. A
# runner built against this var must speak Responses, not Chat Completions.
HYPPO_JUDGE_BASE_URL=
HYPPO_JUDGE_MODEL=
# Reasoning effort for the judge call (Responses API `reasoning.effort`), e.g. low.
# Not read by any runner yet (evals/ is scaffolding only) — reserved name.
HYPPO_JUDGE_EFFORT=
# Verified live 2026-09-14: the endpoint 400s (MissingSessionID) without an
# x-opencode-session header — a stable, caller-chosen ID per conversation, used for
# routing/prompt-caching, not an auth credential. A runner must set one.

# Metered Claude substrate (FR-023 milestone only — NOT used until the user approves
# the credit spend). Placeholder name reserved here so there is a documented home.
# HYPPO_METERED_API_KEY=
